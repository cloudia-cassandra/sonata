flowchart TD
    SPOTIFY["Spotify taste + Deezer previews"] --> ANALYZE["Audio analysis (librosa)<br/>features, labels, star maps"]
    ANALYZE --> LIB[("Library<br/>379 songs + audio features")]

    QUERY[/"User request"/] --> GUARD{"Input guardrail"}
    GUARD -->|empty or over 500 characters| REJECT[/"Rejection message"/]
    GUARD -->|ok| RETRIEVER["Retriever<br/>text similarity + taste, keeps 8"]
    LIB --> RETRIEVER
    RETRIEVER -->|best match below 0.40| FALLBACK["Retrieval-only fallback"]
    RETRIEVER --> LLM["LLM (Gemini, mock by default)<br/>picks from the 8 songs, explains why"]
    LLM -->|API error or daily quota| FALLBACK
    LLM --> VALIDATOR["Validator<br/>drops invented and duplicate songs;<br/>too few left: fallback"]
    VALIDATOR --> OUTPUT[/"Songs + reasons + retrieval similarity"/]
    FALLBACK --> OUTPUT
    OUTPUT -.-> LOG[("Logs<br/>every request")]

    TESTS["Evaluation script + pytest<br/>grounding, consistency, bad input"] -->|runs queries| QUERY
    TESTS -->|evaluation writes| REPORT[("Reports")]
    REPORT --> HUMAN(["Human review"])
    LOG --> HUMAN
    HUMAN -.->|tune| RETRIEVER
