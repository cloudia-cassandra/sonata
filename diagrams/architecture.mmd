flowchart TD
    subgraph DATA["Data · offline, run once"]
        SRC["Spotify taste → Deezer previews → librosa analysis"] --> LIB[("379 songs<br/>audio features + labels")]
    end

    subgraph AGENT["Agentic workflow · mood labeling"]
        HAND["Hand labels<br/>sonata.label"] -->|15 examples| LABEL["1 · Label<br/>Gemini, 25 songs per call"]
        LABEL --> CHECK{"2 · Check<br/>4 rules, no model"}
        CHECK -->|flagged| FIX["3 · Fix<br/>Gemini sees the evidence"]
        FIX --> RECHECK{"Re-check"}
        RECHECK -->|still flagged| REVIEW(["4 · Human review<br/>sonata.review"])
        CHECK -->|ok| MOODS[("Song moods<br/>hand labels always win")]
        RECHECK -->|ok| MOODS
        REVIEW --> HAND
        HAND --> MOODS
    end

    subgraph RAG["RAG workflow · sonata ask"]
        Q[/"Request"/] --> RET["Retrieve 8 songs<br/>MiniLM: relevance first, 15% taste"]
        RET --> LLM["Gemini picks 3-5 as JSON<br/>cache · 18 calls/day · mock by default"]
        LLM --> VAL{"Guardrails<br/>only retrieved songs"}
        VAL -->|valid| OUT[/"Songs + reasons<br/>+ retrieval similarity"/]
        VAL -->|bad answer, API error,<br/>nothing matches| FB["Retrieval-only fallback"] --> OUT
    end

    subgraph REC["Content-based · sonata recommend"]
        COS["Cosine on audio features<br/>vs. closest liked song"] --> TOP[/"Top 5 + why"/]
    end

    WEB["Web app · sonata.server<br/>galaxy · song skies · For you · Ask Sonata"]
    EVAL["Evaluation<br/>reports/: RAG checks, agent vs. held-out hand labels"]

    LIB --> HAND & LABEL & RET & COS
    MOODS --> RET
    OUT --> WEB
    TOP --> WEB
    OUT -.-> EVAL
    MOODS -.-> EVAL
