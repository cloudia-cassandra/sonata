# Copy to .env and fill in from https://developer.spotify.com/dashboard
# Register the redirect URI in your Spotify app settings: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=

# LLM for sonata.rag. LLM_PROVIDER: "mock" (default, no API calls) or "gemini"
LLM_PROVIDER=
# Gemini model name, e.g. from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=
GEMINI_API_KEY=
